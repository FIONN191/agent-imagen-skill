# gen-image · OpenAI API 途径的配置模板
#
# 用法：在 skill 目录里复制一份再填 Key（.env 已写进 .gitignore，不会被提交）：
#   cp .env.example .env && chmod 600 .env
# 填好后自检（不生图、不花钱）：
#   python3 scripts/openai_image.py --check
#
# 这里填了 OPENAI_API_KEY 时，连接设置（Key / 地址 / 组织 / 项目 / 代理）只看这个文件，
# 不读系统环境变量；这里不填 Key 时，才用系统环境变量 OPENAI_API_KEY 和 OPENAI_BASE_URL。

# 必填：在 https://platform.openai.com/api-keys 创建（sk-proj-... 或 sk-...）
# 注意：用 GPT Image 前组织要先完成验证（Settings → Organization → General → Verify Organization），
# 并在 Billing 里充值；ChatGPT 会员不包含 API 额度。
OPENAI_API_KEY=

# ---------- 以下都是可选项，去掉行首 # 生效 ----------

# 访问 api.openai.com 需要代理时填 HTTP 代理（不支持 socks5://；Clash 的 7890 端口即可）
# HTTPS_PROXY=http://127.0.0.1:7890

# Key 属于多个组织或项目时，指定计费的组织 / 项目
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT_ID=proj_...

# API 地址（默认官方地址，一般不用改）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 默认参数（命令行参数优先）
# OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst   # 也可以填 gpt-image-2.6-flare、gpt-image-2.5-sunburst、gpt-image-2.5-flare、gpt-image-2
# OPENAI_IMAGE_QUALITY=high                   # low / medium / high / xhigh / max / auto
# OPENAI_IMAGE_RESOLUTION=2K                  # 1K / 2K / 4K
# OPENAI_IMAGE_FORMAT=png                     # png / jpeg / webp
# OPENAI_IMAGE_MODERATION=auto                # auto / low（low 为较宽松的内容过滤）
# OPENAI_IMAGE_TIMEOUT=600                    # 单次请求最长等待秒数（4K / max 可能要几分钟）
